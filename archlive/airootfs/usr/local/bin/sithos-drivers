#!/bin/bash
# Sith OS Driver Manager

PURPLE='\033[1;35m'
CYAN='\033[1;36m'
RED='\033[1;31m'
GREEN='\033[1;32m'
AMBER='\033[1;33m'
DIM='\033[2m'
NC='\033[0m'

echo -e "${PURPLE}  ═══ SITH OS DRIVER MANAGER ═══${NC}"
echo ""

NVIDIA_PKG=""
NVIDIA_GPU=$(lspci -nn | grep -iE 'vga|3d|display' | grep -i nvidia)
AMD_GPU=$(lspci -nn | grep -iE 'vga|3d|display' | grep -i amd)
INTEL_GPU=$(lspci -nn | grep -iE 'vga|3d|display' | grep -i intel)

echo -e "${CYAN}  Detected hardware:${NC}"
[[ -n "$NVIDIA_GPU" ]] && echo -e "  ${GREEN}▸${NC} NVIDIA GPU"
[[ -n "$AMD_GPU" ]] && echo -e "  ${GREEN}▸${NC} AMD GPU"
[[ -n "$INTEL_GPU" ]] && echo -e "  ${GREEN}▸${NC} Intel GPU"
echo ""

echo -e "${CYAN}  Available actions:${NC}"
echo ""
echo -e "  ${PURPLE}1)${NC} Auto-configure GPU drivers"
echo -e "  ${PURPLE}2)${NC} Install NVIDIA proprietary driver"
echo -e "  ${PURPLE}3)${NC} Remove NVIDIA driver (use open-source mesa)"
echo -e "  ${PURPLE}4)${NC} Configure NVIDIA for Wayland"
echo -e "  ${PURPLE}5)${NC} Install Bluetooth firmware"
echo -e "  ${PURPLE}6)${NC} Install printer support"
echo -e "  ${PURPLE}7)${NC} Check firmware updates (fwupd)"
echo -e "  ${PURPLE}8)${NC} Configure hardware video acceleration"
echo -e "  ${PURPLE}9)${NC} Exit"
echo ""
read -p "  Select [1-9]: " choice

case $choice in
    1)
        echo -e "\n${CYAN}  Auto-configuring GPU drivers...${NC}\n"
        if [[ -n "$NVIDIA_GPU" ]]; then
            # Detect GPU generation — nvidia-open-dkms only supports Turing (RTX 20xx) and newer
            NVIDIA_ID=$(echo "$NVIDIA_GPU" | grep -oP '\[\w+:\w+\]' | head -1 | tr -d '[]')
            echo -e "  ${GREEN}▸${NC} NVIDIA detected (${NVIDIA_ID})"
            # Check if nvidia-open-dkms is loaded (means GPU supports it)
            if lsmod | grep -q "^nvidia " && pacman -Q nvidia-open-dkms &>/dev/null 2>&1; then
                echo -e "  ${GREEN}▸${NC} nvidia-open-dkms working — keeping it"
                NVIDIA_PKG="nvidia-open-dkms"
            else
                echo -e "  ${AMBER}▸${NC} Trying nvidia-open-dkms first (Turing+ GPUs)..."
                if sudo pacman -S --needed --noconfirm nvidia-open-dkms 2>/dev/null; then
                    NVIDIA_PKG="nvidia-open-dkms"
                else
                    echo -e "  ${AMBER}▸${NC} Falling back to nvidia-dkms (older GPUs)..."
                    sudo pacman -Rns --noconfirm nvidia-open-dkms 2>/dev/null || true
                    sudo pacman -S --needed --noconfirm nvidia-dkms
                    NVIDIA_PKG="nvidia-dkms"
                fi
            fi
            sudo pacman -S --needed --noconfirm nvidia-utils nvidia-settings egl-wayland lib32-nvidia-utils
            echo 'options nvidia_drm modeset=1' | sudo tee /etc/modprobe.d/nvidia.conf
            echo 'MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)' | sudo tee /etc/mkinitcpio.conf.d/nvidia.conf
            sudo mkinitcpio -P
            echo -e "\n  ${GREEN}NVIDIA configured ($NVIDIA_PKG). Reboot to apply.${NC}"
        fi
        if [[ -n "$AMD_GPU" ]]; then
            echo -e "  ${GREEN}▸${NC} AMD detected — mesa drivers already installed"
            sudo pacman -S --needed --noconfirm mesa vulkan-radeon lib32-mesa lib32-vulkan-radeon libva-mesa-driver mesa
            echo -e "  ${GREEN}AMD drivers up to date.${NC}"
        fi
        if [[ -n "$INTEL_GPU" ]]; then
            echo -e "  ${GREEN}▸${NC} Intel detected — ensuring media driver..."
            sudo pacman -S --needed --noconfirm mesa intel-media-driver vulkan-intel lib32-mesa lib32-vulkan-intel
            echo -e "  ${GREEN}Intel drivers up to date.${NC}"
        fi
        if [[ -z "$NVIDIA_GPU" ]]; then
            echo -e "  ${DIM}No NVIDIA GPU — removing unused NVIDIA packages to save space...${NC}"
            sudo pacman -Rns --noconfirm nvidia-open-dkms nvidia-utils nvidia-settings egl-wayland lib32-nvidia-utils 2>/dev/null || true
            echo -e "  ${GREEN}Cleaned up.${NC}"
        fi
        ;;
    2)
        echo -e "\n${CYAN}  Installing NVIDIA proprietary driver...${NC}\n"
        sudo pacman -S --needed nvidia-open-dkms nvidia-utils nvidia-settings egl-wayland lib32-nvidia-utils
        echo 'options nvidia_drm modeset=1' | sudo tee /etc/modprobe.d/nvidia.conf
        echo 'MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)' | sudo tee /etc/mkinitcpio.conf.d/nvidia.conf
        sudo mkinitcpio -P
        echo -e "\n  ${GREEN}NVIDIA installed. Reboot to apply.${NC}"
        ;;
    3)
        echo -e "\n${CYAN}  Removing NVIDIA driver...${NC}\n"
        sudo pacman -Rns nvidia-open-dkms nvidia-utils nvidia-settings egl-wayland lib32-nvidia-utils 2>/dev/null
        sudo rm -f /etc/modprobe.d/nvidia.conf /etc/mkinitcpio.conf.d/nvidia.conf
        sudo mkinitcpio -P
        echo -e "\n  ${GREEN}NVIDIA removed. Using mesa/nouveau. Reboot to apply.${NC}"
        ;;
    4)
        echo -e "\n${CYAN}  Configuring NVIDIA for Wayland...${NC}\n"
        echo 'options nvidia_drm modeset=1' | sudo tee /etc/modprobe.d/nvidia.conf
        echo 'MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)' | sudo tee /etc/mkinitcpio.conf.d/nvidia.conf
        sudo pacman -S --needed --noconfirm egl-wayland
        sudo mkinitcpio -P
        echo -e "\n  ${GREEN}NVIDIA Wayland support configured. Reboot to apply.${NC}"
        ;;
    5)
        echo -e "\n${CYAN}  Installing Bluetooth support...${NC}\n"
        sudo pacman -S --needed bluez bluez-utils
        sudo systemctl enable --now bluetooth.service
        echo -e "\n  ${GREEN}Bluetooth enabled.${NC}"
        ;;
    6)
        echo -e "\n${CYAN}  Installing printer support...${NC}\n"
        sudo pacman -S --needed cups cups-filters hplip system-config-printer
        sudo systemctl enable --now cups.service
        echo -e "\n  ${GREEN}Printing enabled. Open System Settings > Printers to add a printer.${NC}"
        ;;
    7)
        echo -e "\n${CYAN}  Checking firmware updates...${NC}\n"
        if command -v fwupdmgr &>/dev/null; then
            fwupdmgr refresh --force
            fwupdmgr get-updates
        else
            echo -e "  ${RED}fwupd not installed.${NC}"
            echo "  Install with: sudo pacman -S fwupd"
        fi
        ;;
    8)
        echo -e "\n${CYAN}  Configuring hardware video acceleration...${NC}\n"
        sudo pacman -S --needed libva-utils
        if [[ -n "$INTEL_GPU" ]]; then
            sudo pacman -S --needed intel-media-driver
        fi
        if [[ -n "$AMD_GPU" ]]; then
            sudo pacman -S --needed libva-mesa-driver mesa
        fi
        echo ""
        echo -e "  ${CYAN}VA-API status:${NC}"
        vainfo 2>&1 | head -5
        echo -e "\n  ${GREEN}Hardware acceleration configured.${NC}"
        ;;
    9|"")
        exit 0
        ;;
esac
