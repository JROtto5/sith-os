#!/bin/bash
# Sith OS Wallpaper Switcher

WALLPAPER_DIR="/usr/share/wallpapers/sithos"
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
NC='\033[0m'

# List available wallpapers
shopt -s nullglob
wallpapers=("$WALLPAPER_DIR"/*.{png,jpg})
shopt -u nullglob

if [[ ${#wallpapers[@]} -eq 0 ]]; then
    echo -e "${PURPLE}No wallpapers found in $WALLPAPER_DIR${NC}"
    exit 1
fi

if [[ "$1" == "--list" || "$1" == "-l" ]]; then
    echo -e "${PURPLE}  ═══ Available Wallpapers ═══${NC}"
    echo ""
    for i in "${!wallpapers[@]}"; do
        name=$(basename "${wallpapers[$i]}")
        echo -e "  ${CYAN}$((i+1)))${NC} $name"
    done
    echo ""
    exit 0
fi

if [[ "$1" == "--random" || "$1" == "-r" ]]; then
    PICK="${wallpapers[$RANDOM % ${#wallpapers[@]}]}"
elif [[ -n "$1" && "$1" =~ ^[0-9]+$ ]]; then
    idx=$(($1 - 1))
    if [[ $idx -ge 0 && $idx -lt ${#wallpapers[@]} ]]; then
        PICK="${wallpapers[$idx]}"
    else
        echo "Invalid selection. Use --list to see options."
        exit 1
    fi
else
    echo -e "${PURPLE}  ═══ Sith Wallpaper Switcher ═══${NC}"
    echo ""
    for i in "${!wallpapers[@]}"; do
        name=$(basename "${wallpapers[$i]}")
        echo -e "  ${CYAN}$((i+1)))${NC} $name"
    done
    echo ""
    read -p "  Select [1-${#wallpapers[@]}]: " choice
    idx=$((choice - 1))
    if [[ $idx -ge 0 && $idx -lt ${#wallpapers[@]} ]]; then
        PICK="${wallpapers[$idx]}"
    else
        echo "Invalid selection."
        exit 1
    fi
fi

# Apply via Plasma D-Bus
WALLPAPER_PATH="$PICK"

# Use plasma-apply-wallpaperimage if available (Plasma 6)
if command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$WALLPAPER_PATH"
    echo -e "${CYAN}  Wallpaper set:${NC} $(basename "$WALLPAPER_PATH")"
else
    # Fallback: use qdbus
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var allDesktops = desktops();
        for (var i = 0; i < allDesktops.length; i++) {
            var d = allDesktops[i];
            d.wallpaperPlugin = 'org.kde.image';
            d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
            d.writeConfig('Image', 'file://${WALLPAPER_PATH}');
        }
    "
    echo -e "${CYAN}  Wallpaper set:${NC} $(basename "$WALLPAPER_PATH")"
fi
