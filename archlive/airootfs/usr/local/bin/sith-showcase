#!/bin/bash
# SITH OS Showcase — Demo all the rice

# Kill any existing showcase
pkill -f "sith-showcase-instance" 2>/dev/null

# Use a tmux session for reliability
SESSION="sith-showcase"

# Kill existing session
tmux kill-session -t "$SESSION" 2>/dev/null

# Create tmux session with custom layout
tmux new-session -d -s "$SESSION" -x 200 -y 50

# Pane 1: fastfetch (top-left)
tmux send-keys -t "$SESSION" 'clear && fastfetch && echo "" && echo -e "\033[1;35m  ═══ SITH OS ═══\033[0m" && echo -e "\033[1;36m  The Dark Side of Linux\033[0m" && echo "" && echo -e "\033[2m  Press Ctrl+B then D to exit showcase\033[0m"' C-m

# Pane 2: btop (top-right)
tmux split-window -h -t "$SESSION"
tmux send-keys -t "$SESSION" 'btop' C-m

# Pane 3: cmatrix (bottom-left)
tmux split-window -v -t "$SESSION:.0"
tmux send-keys -t "$SESSION" 'cmatrix -b -u 3 -C magenta' C-m

# Pane 4: cava (bottom-right)
tmux split-window -v -t "$SESSION:.1"
tmux send-keys -t "$SESSION" 'cava' C-m

# Attach
kitty --title "Sith OS Showcase" -e tmux attach -t "$SESSION" 2>/dev/null || \
    tmux attach -t "$SESSION"
