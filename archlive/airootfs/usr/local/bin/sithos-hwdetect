#!/bin/bash
# Sith OS Hardware Detection & Driver Configuration

PURPLE='\033[1;35m'
CYAN='\033[1;36m'
RED='\033[1;31m'
GREEN='\033[1;32m'
AMBER='\033[1;33m'
DIM='\033[2m'
NC='\033[0m'

echo -e "${PURPLE}  ═══ SITH OS HARDWARE DETECTION ═══${NC}"
echo ""

# ── GPU Detection ──
echo -e "${CYAN}  ── Graphics ──${NC}"
NVIDIA_GPU=$(lspci -nn | grep -iE 'vga|3d|display' | grep -i nvidia)
AMD_GPU=$(lspci -nn | grep -iE 'vga|3d|display' | grep -i amd)
INTEL_GPU=$(lspci -nn | grep -iE 'vga|3d|display' | grep -i intel)

if [[ -n "$NVIDIA_GPU" ]]; then
    echo -e "  ${GREEN}▸${NC} NVIDIA: $(echo "$NVIDIA_GPU" | sed 's/.*: //')"

    # Check if nvidia driver is loaded
    if lsmod | grep -q "^nvidia "; then
        NVIDIA_VER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null || echo "unknown")
        echo -e "    ${GREEN}Driver loaded${NC}: nvidia $NVIDIA_VER"

        # Check Wayland readiness
        if [[ -f /etc/modprobe.d/nvidia.conf ]] && grep -q "modeset=1" /etc/modprobe.d/nvidia.conf; then
            echo -e "    ${GREEN}DRM modeset${NC}: enabled (Wayland ready)"
        else
            echo -e "    ${AMBER}DRM modeset${NC}: not configured"
            echo -e "    ${DIM}  Fix: echo 'options nvidia_drm modeset=1 fbdev=1' | sudo tee /etc/modprobe.d/nvidia.conf${NC}"
        fi
    else
        echo -e "    ${AMBER}Driver${NC}: nvidia module not loaded (nouveau may be active)"
    fi
fi

if [[ -n "$AMD_GPU" ]]; then
    echo -e "  ${GREEN}▸${NC} AMD: $(echo "$AMD_GPU" | sed 's/.*: //')"
    if lsmod | grep -q "^amdgpu "; then
        echo -e "    ${GREEN}Driver loaded${NC}: amdgpu (open source)"
    fi
    # Check VA-API
    if command -v vainfo &>/dev/null; then
        VA_PROFILES=$(vainfo 2>/dev/null | grep -c "VAProfile" || echo "0")
        echo -e "    ${GREEN}VA-API${NC}: $VA_PROFILES decode profiles available"
    fi
fi

if [[ -n "$INTEL_GPU" ]]; then
    echo -e "  ${GREEN}▸${NC} Intel: $(echo "$INTEL_GPU" | sed 's/.*: //')"
    echo -e "    ${GREEN}Driver${NC}: i915/xe (built-in)"
fi

if [[ -z "$NVIDIA_GPU" && -z "$AMD_GPU" && -z "$INTEL_GPU" ]]; then
    echo -e "  ${RED}▸${NC} No GPU detected (using generic framebuffer)"
fi

# ── CPU ──
echo ""
echo -e "${CYAN}  ── Processor ──${NC}"
CPU_MODEL=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)
CPU_CORES=$(nproc)
CPU_ARCH=$(gcc -march=native -Q --help=target 2>/dev/null | grep '^\s*-march=' | awk '{print $2}' || echo "unknown")
echo -e "  ${GREEN}▸${NC} $CPU_MODEL"
echo -e "    Threads: $CPU_CORES | Arch: $CPU_ARCH"

# ── Memory ──
echo ""
echo -e "${CYAN}  ── Memory ──${NC}"
RAM_TOTAL=$(free -h | awk '/Mem:/{print $2}')
SWAP_TOTAL=$(free -h | awk '/Swap:/{print $2}')
ZRAM=$(lsblk -d | grep zram | awk '{print $4}' | head -1)
echo -e "  ${GREEN}▸${NC} RAM: $RAM_TOTAL"
echo -e "  ${GREEN}▸${NC} Swap: $SWAP_TOTAL${ZRAM:+ (zram: $ZRAM)}"

# ── Storage ──
echo ""
echo -e "${CYAN}  ── Storage ──${NC}"
lsblk -d -o NAME,SIZE,MODEL,ROTA,TYPE 2>/dev/null | grep disk | while read NAME SIZE MODEL ROTA TYPE; do
    if [[ "$ROTA" == "0" ]]; then
        DTYPE="SSD"
    else
        DTYPE="HDD"
    fi
    echo -e "  ${GREEN}▸${NC} /dev/$NAME: $SIZE $DTYPE ${DIM}$MODEL${NC}"
done

# ── Network ──
echo ""
echo -e "${CYAN}  ── Network ──${NC}"
# WiFi
WIFI=$(iw dev 2>/dev/null | grep Interface | awk '{print $2}')
if [[ -n "$WIFI" ]]; then
    WIFI_DRIVER=$(basename "$(readlink "/sys/class/net/$WIFI/device/driver" 2>/dev/null)" 2>/dev/null)
    WIFI_DRIVER="${WIFI_DRIVER:-unknown}"
    echo -e "  ${GREEN}▸${NC} WiFi: $WIFI (driver: $WIFI_DRIVER)"
else
    echo -e "  ${DIM}▸ No WiFi adapter detected${NC}"
fi

# Ethernet
ETH=$(ip link show | grep -E '^[0-9]+: (e|enp)' | awk -F: '{print $2}' | xargs | head -1)
if [[ -n "$ETH" ]]; then
    echo -e "  ${GREEN}▸${NC} Ethernet: $ETH"
fi

# Bluetooth
if [[ -d /sys/class/bluetooth ]]; then
    BT_DEV=$(ls /sys/class/bluetooth/ 2>/dev/null | head -1)
    echo -e "  ${GREEN}▸${NC} Bluetooth: $BT_DEV"
else
    echo -e "  ${DIM}▸ No Bluetooth adapter detected${NC}"
fi

# ── Boot ──
echo ""
echo -e "${CYAN}  ── System ──${NC}"
if [[ -d /sys/firmware/efi ]]; then
    echo -e "  ${GREEN}▸${NC} Boot: UEFI"
    if [[ -d /sys/firmware/efi/efivars ]]; then
        echo -e "    Secure Boot: $(cat /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | od -An -t u1 | awk '{print $NF}' | head -1 | sed 's/1/enabled/;s/0/disabled/' 2>/dev/null || echo 'unknown')"
    fi
else
    echo -e "  ${GREEN}▸${NC} Boot: Legacy BIOS"
fi

# Battery
if [[ -d /sys/class/power_supply/BAT0 ]]; then
    BAT_STATUS=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
    BAT_CAP=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
    echo -e "  ${GREEN}▸${NC} Battery: ${BAT_CAP}% ($BAT_STATUS) — laptop detected"
fi

# Firmware updates available
if command -v fwupdmgr &>/dev/null; then
    FW_COUNT=$(fwupdmgr get-updates 2>/dev/null | grep -c "New version" || echo "0")
    if [[ "$FW_COUNT" -gt 0 ]]; then
        echo -e "  ${AMBER}▸${NC} Firmware: $FW_COUNT updates available (run: fwupdmgr update)"
    fi
fi

echo ""
echo -e "${PURPLE}  ═══════════════════════════════════${NC}"
echo -e "  ${DIM}Run 'sithos-drivers' to install/configure drivers${NC}"
echo ""
